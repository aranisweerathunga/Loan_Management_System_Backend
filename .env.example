NODE_ENV=development
PORT=3000

# PostgreSQL connection for the existing local database.
# Do not use the postgres superuser for ongoing development.
# Create a dedicated role such as loan_app and use that account here.
# Example:
# postgresql://loan_app:PASSWORD@localhost:5432/loan_management_db
DATABASE_URL=postgresql://USER:PASSWORD@localhost:5432/loan_management_db

# Prisma Migrate development shadow database.
# This must be a separate disposable database from DATABASE_URL.
# Example:
# postgresql://loan_app:PASSWORD@localhost:5432/loan_management_shadow
SHADOW_DATABASE_URL=postgresql://USER:PASSWORD@localhost:5432/loan_management_shadow

# Comma-separated browser origins allowed to call the API.
CORS_ORIGIN=http://localhost:5173