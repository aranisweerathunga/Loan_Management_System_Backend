generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum ProductVersionStatus {
  DRAFT
  ACTIVE
  RETIRED
}

model ProductCategory {
  id          String        @id @default(uuid())
  code        String        @unique
  name        String
  description String?
  isActive    Boolean       @default(true)
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt
  products    LoanProduct[]
}

model LoanProduct {
  id               String            @id @default(uuid())
  categoryId       String
  code             String            @unique
  name             String
  description      String?
  isActive         Boolean           @default(true)
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt
  category         ProductCategory   @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  purposes         ProductPurpose[]
  versions         ProductVersion[]
  loanApplications LoanApplication[]
  loanFacilities   LoanFacility[]

  @@index([categoryId])
}

model ProductPurpose {
  id               String            @id @default(uuid())
  loanProductId    String
  code             String
  name             String
  description      String?
  isActive         Boolean           @default(true)
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt
  loanProduct      LoanProduct       @relation(fields: [loanProductId], references: [id], onDelete: Restrict)
  loanApplications LoanApplication[]
  loanFacilities   LoanFacility[]

  @@unique([loanProductId, code])
  @@index([loanProductId])
}

model ProductVersion {
  id                     String                  @id @default(uuid())
  loanProductId          String
  versionNumber          Int
  status                 ProductVersionStatus    @default(DRAFT)
  effectiveFrom          DateTime                @db.Date
  effectiveTo            DateTime?               @db.Date
  configuration          Json
  createdAt              DateTime                @default(now())
  updatedAt              DateTime                @updatedAt
  loanProduct            LoanProduct             @relation(fields: [loanProductId], references: [id], onDelete: Restrict)
  loanApplications       LoanApplication[]
  eligibilityAssessments EligibilityAssessment[]
  loanFacilities         LoanFacility[]

  @@unique([loanProductId, versionNumber])
  @@index([loanProductId])
  @@index([loanProductId, status])
}

enum EpfBalanceSource {
  MANUAL
  IMPORT
}

model Borrower {
  id               String               @id @default(uuid())
  firstName        String
  middleName       String?
  lastName         String
  dateOfBirth      DateTime?            @db.Date
  email            String?
  phone            String?
  isActive         Boolean              @default(true)
  createdAt        DateTime             @default(now())
  updatedAt        DateTime             @updatedAt
  identifiers      BorrowerIdentifier[]
  employeeProfile  EmployeeProfile?
  loanApplications LoanApplication[]
  loanFacilities   LoanFacility[]
}

model BorrowerIdentifier {
  id         String   @id @default(uuid())
  borrowerId String
  type       String
  value      String
  isPrimary  Boolean  @default(false)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  borrower   Borrower @relation(fields: [borrowerId], references: [id], onDelete: Restrict)

  @@unique([type, value])
  @@index([borrowerId])
}

model EmployeeProfile {
  id                String              @id @default(uuid())
  borrowerId        String              @unique
  isActive          Boolean             @default(true)
  createdAt         DateTime            @default(now())
  updatedAt         DateTime            @updatedAt
  borrower          Borrower            @relation(fields: [borrowerId], references: [id], onDelete: Restrict)
  employmentHistory EmploymentHistory[]
  gradeHistory      GradeHistory[]
  epfBalanceHistory EpfBalanceHistory[]
}

model EmploymentHistory {
  id                String          @id @default(uuid())
  employeeProfileId String
  status            String
  effectiveFrom     DateTime        @db.Date
  effectiveTo       DateTime?       @db.Date
  createdAt         DateTime        @default(now())
  updatedAt         DateTime        @updatedAt
  employeeProfile   EmployeeProfile @relation(fields: [employeeProfileId], references: [id], onDelete: Restrict)

  @@index([employeeProfileId])
  @@index([employeeProfileId, effectiveFrom])
}

model Grade {
  id           String         @id @default(uuid())
  code         String         @unique
  name         String
  description  String?
  isActive     Boolean        @default(true)
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt
  gradeHistory GradeHistory[]
}

model GradeHistory {
  id                String          @id @default(uuid())
  employeeProfileId String
  gradeId           String
  effectiveFrom     DateTime        @db.Date
  effectiveTo       DateTime?       @db.Date
  createdAt         DateTime        @default(now())
  updatedAt         DateTime        @updatedAt
  employeeProfile   EmployeeProfile @relation(fields: [employeeProfileId], references: [id], onDelete: Restrict)
  grade             Grade           @relation(fields: [gradeId], references: [id], onDelete: Restrict)

  @@index([employeeProfileId])
  @@index([gradeId])
  @@index([employeeProfileId, effectiveFrom])
}

model EpfBalanceHistory {
  id                String           @id @default(uuid())
  employeeProfileId String
  balance           Decimal          @db.Decimal(18, 2)
  asOfDate          DateTime         @db.Date
  source            EpfBalanceSource
  createdAt         DateTime         @default(now())
  updatedAt         DateTime         @updatedAt
  employeeProfile   EmployeeProfile  @relation(fields: [employeeProfileId], references: [id], onDelete: Restrict)

  @@unique([employeeProfileId, asOfDate])
  @@index([employeeProfileId])
}

enum LoanApplicationStatus {
  DRAFT
  SUBMITTED
  UNDER_REVIEW
  APPROVED
  REJECTED
}

enum ApplicationDecisionType {
  APPROVED
  REJECTED
}

enum EligibilityAssessmentStatus {
  PENDING
  COMPLETED
}

model LoanApplicationNumberSequence {
  calendarYear Int @id
  lastValue    Int
}

model LoanApplication {
  id                     String                     @id @default(uuid())
  applicationNumber      String                     @unique
  borrowerId             String
  loanProductId          String
  productVersionId       String
  productPurposeId       String?
  status                 LoanApplicationStatus      @default(DRAFT)
  submittedAt            DateTime?
  createdAt              DateTime                   @default(now())
  updatedAt              DateTime                   @updatedAt
  borrower               Borrower                   @relation(fields: [borrowerId], references: [id], onDelete: Restrict)
  loanProduct            LoanProduct                @relation(fields: [loanProductId], references: [id], onDelete: Restrict)
  productVersion         ProductVersion             @relation(fields: [productVersionId], references: [id], onDelete: Restrict)
  productPurpose         ProductPurpose?            @relation(fields: [productPurposeId], references: [id], onDelete: Restrict)
  statusHistory          ApplicationStatusHistory[]
  eligibilityAssessments EligibilityAssessment[]
  decisions              ApplicationDecision[]
  facility               LoanFacility?

  @@index([borrowerId])
  @@index([status])
  @@index([loanProductId])
  @@index([productVersionId])
  @@index([productPurposeId])
}

model ApplicationStatusHistory {
  id                String                 @id @default(uuid())
  loanApplicationId String
  fromStatus        LoanApplicationStatus?
  toStatus          LoanApplicationStatus
  changedAt         DateTime               @default(now())
  note              String?
  loanApplication   LoanApplication        @relation(fields: [loanApplicationId], references: [id], onDelete: Restrict)

  @@index([loanApplicationId])
  @@index([loanApplicationId, changedAt])
}

model EligibilityAssessment {
  id                String                      @id @default(uuid())
  loanApplicationId String
  productVersionId  String
  status            EligibilityAssessmentStatus @default(PENDING)
  inputSnapshot     Json
  ruleSnapshot      Json
  resultSnapshot    Json?
  assessedAt        DateTime?
  createdAt         DateTime                    @default(now())
  updatedAt         DateTime                    @updatedAt
  loanApplication   LoanApplication             @relation(fields: [loanApplicationId], references: [id], onDelete: Restrict)
  productVersion    ProductVersion              @relation(fields: [productVersionId], references: [id], onDelete: Restrict)

  @@index([loanApplicationId])
  @@index([productVersionId])
}

/// Explicit approval or rejection. No actor is stored: authentication does not exist yet, so a trusted decided-by reference can be added later without changing this decision record.
/// authorizedPrincipalAmount is historical approval data. It is required for new APPROVED decisions and remains null for REJECTED decisions and for approvals recorded before the amount existed.
model ApplicationDecision {
  id                        String                  @id @default(uuid())
  loanApplicationId         String
  decision                  ApplicationDecisionType
  remarks                   String?
  authorizedPrincipalAmount Decimal?                @db.Decimal(18, 2)
  decidedAt                 DateTime                @default(now())
  createdAt                 DateTime                @default(now())
  loanApplication           LoanApplication         @relation(fields: [loanApplicationId], references: [id], onDelete: Restrict)

  @@index([loanApplicationId])
  @@index([loanApplicationId, decidedAt])
}

enum LoanFacilityStatus {
  PENDING_DISBURSEMENT
  ACTIVE
}

enum LoanTransactionType {
  DISBURSEMENT
}

enum FinancialSnapshotType {
  INTEREST_CALCULATION
  REPAYMENT_SCHEDULE
}

model LoanFacilityNumberSequence {
  calendarYear Int @id
  lastValue    Int
}

/// One facility per approved application. The authorized amount is copied from the approval decision and is not supplied by the caller.
model LoanFacility {
  id                        String             @id @default(uuid())
  facilityNumber            String             @unique
  loanApplicationId         String             @unique
  borrowerId                String
  loanProductId             String
  productVersionId          String
  productPurposeId          String?
  authorizedPrincipalAmount Decimal            @db.Decimal(18, 2)
  currencyCode              String             @db.VarChar(3)
  facilityDate              DateTime           @db.Date
  status                    LoanFacilityStatus @default(PENDING_DISBURSEMENT)
  createdAt                 DateTime           @default(now())
  updatedAt                 DateTime           @updatedAt
  loanApplication           LoanApplication    @relation(fields: [loanApplicationId], references: [id], onDelete: Restrict)
  borrower                  Borrower           @relation(fields: [borrowerId], references: [id], onDelete: Restrict)
  loanProduct               LoanProduct        @relation(fields: [loanProductId], references: [id], onDelete: Restrict)
  productVersion            ProductVersion     @relation(fields: [productVersionId], references: [id], onDelete: Restrict)
  productPurpose            ProductPurpose?    @relation(fields: [productPurposeId], references: [id], onDelete: Restrict)
  disbursements             LoanDisbursement[]
  transactions              LoanTransaction[]
  interestCalculations      InterestCalculation[]
  repaymentSchedules        RepaymentSchedule[]
  financialSnapshotRequests FinancialSnapshotRequest[]

  @@unique([id, productVersionId])
  @@index([borrowerId])
  @@index([loanProductId])
  @@index([productVersionId])
  @@index([productPurposeId])
  @@index([status])
}

/// Actual release of funds against an existing facility authorization. Immutable: no update or delete API.
model LoanDisbursement {
  id               String          @id @default(uuid())
  loanFacilityId   String
  amount           Decimal         @db.Decimal(18, 2)
  disbursementDate DateTime        @db.Date
  reference        String?         @db.VarChar(120)
  remarks          String?         @db.VarChar(500)
  createdAt        DateTime        @default(now())
  loanFacility     LoanFacility    @relation(fields: [loanFacilityId], references: [id], onDelete: Restrict)
  loanTransaction  LoanTransaction?

  @@index([loanFacilityId])
  @@index([loanFacilityId, disbursementDate])
}

/// Append-only facility subledger. Phase 7A records DISBURSEMENT only. A disbursement transaction points at the LoanDisbursement that created it.
model LoanTransaction {
  id                 String              @id @default(uuid())
  loanFacilityId     String
  type               LoanTransactionType
  principalAmount    Decimal             @db.Decimal(18, 2)
  transactionDate    DateTime            @db.Date
  loanDisbursementId String?             @unique
  createdAt          DateTime            @default(now())
  loanFacility       LoanFacility        @relation(fields: [loanFacilityId], references: [id], onDelete: Restrict)
  loanDisbursement   LoanDisbursement?   @relation(fields: [loanDisbursementId], references: [id], onDelete: Restrict)

  @@index([loanFacilityId])
  @@index([loanFacilityId, transactionDate])
}

/// Append-only interest calculation snapshot. A later calculation inserts a new row.
/// periodStart and periodEnd are stored only when a caller supplies already-resolved bounds.
/// This model does not derive a calendar year, anniversary, or facility year, and it does not select an MSPS anchor.
/// productVersionId must be the facility's own ProductVersion. historySequence is append order, not financial authority.
model InterestCalculation {
  id                      String               @id @default(uuid())
  loanFacilityId          String
  productVersionId        String
  /// Facility-scoped append order. A future writer allocates it while holding the facility row lock.
  /// The highest value is not the authoritative calculation.
  historySequence         Int
  calculationStrategy     String
  principalAmount         Decimal              @db.Decimal(18, 2)
  annualRate              Decimal              @db.Decimal(18, 4)
  annualInterestAmount    Decimal              @db.Decimal(18, 2)
  allocationFrequency     String
  recalculationFrequency  String
  periodStart             DateTime?            @db.Date
  periodEnd               DateTime?            @db.Date
  inputSnapshot           Json
  policySnapshot          Json
  resultSnapshot          Json
  createdAt               DateTime             @default(now())
  loanFacility              LoanFacility               @relation(fields: [loanFacilityId, productVersionId], references: [id, productVersionId], onDelete: Restrict)
  allocations               InterestAllocation[]
  repaymentSchedules        RepaymentSchedule[]
  financialSnapshotRequests FinancialSnapshotRequest[]

  @@unique([id, loanFacilityId])
  @@unique([loanFacilityId, historySequence])
  @@index([loanFacilityId, createdAt])
}

/// Monthly interest amount from one InterestCalculation. This row has no due date.
model InterestAllocation {
  id                    String              @id @default(uuid())
  interestCalculationId String
  sequence              Int
  interestAmount        Decimal             @db.Decimal(18, 2)
  createdAt             DateTime            @default(now())
  interestCalculation   InterestCalculation @relation(fields: [interestCalculationId], references: [id], onDelete: Restrict)

  @@unique([interestCalculationId, sequence])
  @@index([interestCalculationId])
}

/// Append-only repayment schedule snapshot. A later schedule inserts a new row.
/// interestCalculationId is optional: a schedule may be assembled from supplied allocations that do not come from one stored calculation.
/// When present, the calculation must belong to this same facility. productVersionId must be the facility's own ProductVersion.
/// historySequence is append order for schedules only. It is independent of calculation history and is not financial authority.
/// due dates live on entries. This model does not derive them and does not select MSPS repayment policy.
model RepaymentSchedule {
  id                       String                   @id @default(uuid())
  loanFacilityId           String
  productVersionId         String
  /// Facility-scoped append order among schedules. A future writer allocates it while holding the facility row lock.
  /// The highest value is not the authoritative schedule.
  historySequence          Int
  interestCalculationId    String?
  principalAmount          Decimal                  @db.Decimal(18, 2)
  totalScheduledPrincipal  Decimal                  @db.Decimal(18, 2)
  totalScheduledInterest   Decimal                  @db.Decimal(18, 2)
  totalScheduledAmount     Decimal                  @db.Decimal(18, 2)
  remainingPrincipal       Decimal                  @db.Decimal(18, 2)
  numberOfInstalments      Int
  inputSnapshot            Json
  policySnapshot           Json
  resultSnapshot           Json
  createdAt                DateTime                 @default(now())
  loanFacility              LoanFacility               @relation(fields: [loanFacilityId, productVersionId], references: [id, productVersionId], onDelete: Restrict)
  interestCalculation       InterestCalculation?       @relation(fields: [interestCalculationId, loanFacilityId], references: [id, loanFacilityId], onDelete: Restrict)
  entries                   RepaymentScheduleEntry[]
  financialSnapshotRequests FinancialSnapshotRequest[]

  @@unique([id, loanFacilityId])
  @@unique([loanFacilityId, historySequence])
  @@index([loanFacilityId, createdAt])
  @@index([interestCalculationId])
}

/// One persisted schedule instalment. dueDate is a resolved date supplied by the caller, not an MSPS due-date rule.
model RepaymentScheduleEntry {
  id                    String            @id @default(uuid())
  repaymentScheduleId   String
  sequence              Int
  dueDate               DateTime          @db.Date
  openingPrincipal      Decimal           @db.Decimal(18, 2)
  scheduledPrincipal    Decimal           @db.Decimal(18, 2)
  scheduledInterest     Decimal           @db.Decimal(18, 2)
  totalScheduledAmount  Decimal           @db.Decimal(18, 2)
  closingPrincipal      Decimal           @db.Decimal(18, 2)
  createdAt             DateTime          @default(now())
  repaymentSchedule     RepaymentSchedule @relation(fields: [repaymentScheduleId], references: [id], onDelete: Restrict)

  @@unique([repaymentScheduleId, sequence])
  @@index([repaymentScheduleId])
}

/// Accepted idempotency record for one financial snapshot write.
/// idempotencyKey is supplied by the caller. This model does not generate it.
/// A database CHECK requires exactly one snapshot target, matching snapshotType.
/// Prisma cannot represent that CHECK. ON UPDATE RESTRICT keeps a later identity change from rewriting this link.
/// Snapshots created before this table have no request row and remain valid.
model FinancialSnapshotRequest {
  id                    String                @id @default(uuid())
  loanFacilityId        String
  snapshotType          FinancialSnapshotType
  idempotencyKey        String                @db.Uuid
  requestFingerprint    String                @db.VarChar(64)
  interestCalculationId String?
  repaymentScheduleId   String?
  createdAt             DateTime              @default(now())
  loanFacility          LoanFacility          @relation(fields: [loanFacilityId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  interestCalculation   InterestCalculation?  @relation(fields: [interestCalculationId, loanFacilityId], references: [id, loanFacilityId], onDelete: Restrict, onUpdate: Restrict)
  repaymentSchedule     RepaymentSchedule?    @relation(fields: [repaymentScheduleId, loanFacilityId], references: [id, loanFacilityId], onDelete: Restrict, onUpdate: Restrict)

  @@unique([loanFacilityId, snapshotType, idempotencyKey])
  @@index([interestCalculationId])
  @@index([repaymentScheduleId])
}
